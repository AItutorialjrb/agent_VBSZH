# A1 CHECK (2026-11-03): identical to B_QCD_zaajj_vbs except NO generator mjj cut (mmjj 0), to measure at Delphes level the reco-VBS-region yield missed by mmjj>400 for QCD-type samples (shower tag jets).
# FINAL RUN card (2026-11-02 20:55): prompt Zgg+jj with on-shell Z (narrow width, Z->ee/mumu decay chain), VBS-biased (pta>25, mmjj>400, 100<maa<170). Replaces the full l+l-aajj hedge, whose gridpack integration projected to ~15 h (QCD) and >100 h (EW). Photons radiated in the Z decay are not included (they fail |mll-mZ|<25 or mllgg>100); see FINAL_report limitations.
# production_v2 gridpack card — UNVALIDATED until its gridpack job + one test job pass (reports/04_production_plan.md).
# OUTDIR/SEED substituted by scripts/condor/make_gridpack.sh
set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~
define j = g u c d s b u~ c~ d~ s~ b~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
generate p p > z a a j j QCD=2 QED=3, z > l+ l-
output OUTDIR -nojpeg
launch OUTDIR
0
set run_card ebeam1 6800
set run_card ebeam2 6800
set run_card pdlabel lhapdf
set run_card lhaid 303600
set run_card maxjetflavor 5
set run_card asrwgtflavor 5
set run_card use_syst True
set run_card gridpack True
set run_card nevents 2000
set run_card ptl 10
set run_card etal 2.5
set run_card mmll 50
set run_card drll 0.4
set run_card pta 25
set run_card etaa 2.5
set run_card draa 0.4
set run_card draj 0.4
set run_card dral 0.4
set run_card ptj 20
set run_card etaj 5
set run_card mmjj 0
set run_card mmaa 100
set run_card mmaamax 170
set run_card draa 0.4
set run_card drjj 0.4
set run_card drjl 0.4
set run_card dynamical_scale_choice 3
set run_card iseed SEED
done
