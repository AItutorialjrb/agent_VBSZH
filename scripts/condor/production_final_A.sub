# FINAL RUN production (generated by scripts/plan/make_submit_final.py) -- jobs wait (exit 19 -> hold, auto-release 30 min) until their gridpack exists
P            = /eos/user/r/rjiang/vbs_zh_codex_starter
universe     = vanilla
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
executable   = run_job.sh
arguments    = $(sample) /eos/user/r/rjiang/vbs_zh_codex_starter/production/gridpacks/$(sample)_gridpack_s$(gseed).tar.gz $(nev) $(seed) $(cmnd) /eos/user/r/rjiang/vbs_zh_codex_starter/production/final/$(sample) 0 0
transfer_input_files = $(P)/scripts/setup_stack.sh, $(P)/scripts/run_py8_delphes.sh, $(P)/scripts/slim_gentruth.py, $(P)/cards/phase03_smoke/py8_common_CP5.cmnd, $(P)/cards/phase03_smoke/$(cmnd), $(P)/cards/phase04_candidates/delphes_card_CMS_slim_v1.tcl
output       = /eos/user/r/rjiang/vbs_zh_codex_starter/production/condor_logs/final/$(sample)_$(seed).out
error        = /eos/user/r/rjiang/vbs_zh_codex_starter/production/condor_logs/final/$(sample)_$(seed).err
log          = /eos/user/r/rjiang/vbs_zh_codex_starter/production/condor_logs/production_final.log
request_cpus   = 1
request_memory = 2500
+JobFlavour  = "$(flav)"
max_retries  = 2
success_exit_code = 0
on_exit_hold = (ExitCode =?= 19)
on_exit_hold_reason = "gridpack not yet available"
periodic_release = (HoldReasonCode =?= 3) && ((time() - EnteredCurrentStatus) > 1800) && (NumJobStarts < 200)
queue sample, gseed, cmnd, nev, seed, flav from (
