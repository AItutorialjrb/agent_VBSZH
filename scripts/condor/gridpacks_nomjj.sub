# A1 check (2026-11-03): no-mjj-cut QCD Zgjj / Zggjj gridpacks
# A1 check (2026-11-03): no-mjj-cut QCD Zgjj / Zggjj gridpacks
# Submit with the EosSubmit schedd:  bash -lc 'module load lxbatch/eossubmit; cd /eos/user/r/rjiang/vbs_zh_codex_starter/scripts/condor; condor_submit <this file>'
P            = /eos/user/r/rjiang/vbs_zh_codex_starter
universe     = vanilla
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
executable   = make_gridpack.sh
arguments    = $(card) $(gseed) /eos/user/r/rjiang/vbs_zh_codex_starter/production/gridpacks $(ncore)
transfer_input_files = $(P)/scripts/setup_stack.sh, $(P)/cards/production_final/$(card).mg5
output       = $(P)/production/condor_logs/gpN_$(card).out
error        = $(P)/production/condor_logs/gpN_$(card).err
log          = $(P)/production/condor_logs/gridpacks_final.log
request_cpus   = $(ncore)
request_memory = $(mem)
request_disk   = 20000000
+JobFlavour  = "$(flav)"
max_retries  = 1
queue card, gseed, ncore, mem, flav from (
  F_QCD_llajj_nomjj 1365800 8 16000 workday
  B_QCD_zaajj_nomjj 1365900 16 24000 workday
)
