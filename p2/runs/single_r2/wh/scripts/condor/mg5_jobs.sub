  F_QCD_Wajj cards/phase02/F_QCD_Wajj.mg5 2512000 8 16000 workday
  F_QCD_Wajj_nomjj cards/phase02/F_QCD_Wajj_nomjj.mg5 2529000 8 16000 workday
  F_Wjj cards/phase02/F_Wjj.mg5 2514000 8 16000 workday
  H_EW_WHjj_tau cards/phase02/H_EW_WHjj_tau.mg5 2521000 8 16000 workday
  H_tHq cards/phase02/H_tHq.mg5 2519000 8 16000 workday
  H_tHW cards/phase02/H_tHW.mg5 2520000 8 16000 workday
  H_ttH_1l cards/phase02/H_ttH_1l.mg5 2518000 8 16000 workday
  H_ttH_2l cards/phase02/H_ttH_2l.mg5 2528000 8 16000 workday
