# 2 FAKE PHOTONS (bound): QCD l nu jj (2,2), VBS-biased; fixed order 2 partons = lower bound (extra jets from PS only)
set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
generate p p > l+ vl j j QCD=2 QED=2
add process p p > l- vl~ j j QCD=2 QED=2
output OUTDIR -nojpeg
launch OUTDIR
0
set run_card ebeam1 6800
set run_card ebeam2 6800
set run_card pdlabel lhapdf
set run_card lhaid 303600
set run_card maxjetflavor 4
set run_card asrwgtflavor 5
set run_card use_syst True
set run_card dynamical_scale_choice 3
set run_card cut_decays False
set run_card gridpack False
set run_card nevents 1000
set run_card ptj 20
set run_card etaj 5
set run_card drjj 0.4
set run_card mmjj 400
set run_card ptl 10
set run_card etal 2.5
set run_card drjl 0.4
set run_card iseed SEED
done
