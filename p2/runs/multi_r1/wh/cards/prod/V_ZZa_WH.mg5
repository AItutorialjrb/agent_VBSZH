# WH production card (G2 pre-production, D-WH-5): UNVALIDATED until gridpack + one test job pass. OUTDIR/SEED substituted by runner.
# Lepton cuts are LOOSE (ptl 5, |etal| 3.5, mmll 10) so that lost leptons (acceptance/ID) are covered; no ME jets (jets from PS only): see reports/04 caveats.
set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set group_subprocesses False
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
generate p p > l+ l- l+ l- a
output OUTDIR -nojpeg
launch OUTDIR
0
set run_card ebeam1 6800
set run_card ebeam2 6800
set run_card pdlabel lhapdf
set run_card lhaid 303600
set run_card maxjetflavor 5
set run_card asrwgtflavor 5
set run_card use_syst True
set run_card gridpack True
set run_card nevents 2000
set run_card ptl 5
set run_card etal 3.5
set run_card mmll 10
set run_card drll 0.1
set run_card pta 15
set run_card etaa 2.5
set run_card draa 0.4
set run_card draj 0.4
set run_card dral 0.4
set run_card ptj 0
set run_card drjj 0
set run_card drjl 0
set run_card dynamical_scale_choice 3
set run_card iseed SEED
done
