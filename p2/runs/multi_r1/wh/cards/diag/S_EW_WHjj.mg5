set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
define q = u c d s u~ c~ d~ s~
generate p p > w+ h j j QCD=0 QED=4, w+ > l+ vl
add process p p > w- h j j QCD=0 QED=4, w- > l- vl~
output OUTDIR -nojpeg
quit
