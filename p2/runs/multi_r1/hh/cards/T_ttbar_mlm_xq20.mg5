# hh card, UNVALIDATED until reports/03 says otherwise. OUTDIR substituted by scripts/condor/make_gridpack_hh.sh
set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~
define j = g u c d s b u~ c~ d~ s~ b~
generate p p > t t~ @0
add process p p > t t~ j @1
add process p p > t t~ j j @2
output OUTDIR -nojpeg
launch OUTDIR
0
set run_card ebeam1 6800
set run_card ebeam2 6800
set run_card pdlabel lhapdf
set run_card lhaid 303600
set run_card maxjetflavor 5
set run_card asrwgtflavor 5
set run_card use_syst True
set run_card gridpack True
set run_card nevents 2000
set run_card iseed 3132003
set run_card dynamical_scale_choice -1
set run_card ptj 20
set run_card etaj -1
set run_card drjj 0
set run_card use_syst False
set run_card ickkw 1
set run_card ptheavy 250
set run_card xqcut 20
done
