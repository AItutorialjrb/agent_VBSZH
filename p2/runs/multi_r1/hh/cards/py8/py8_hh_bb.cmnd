SpaceShower:dipoleRecoil = on
! H->bb forced (conditional BR=1); physical B(H->bb) applied ONCE in the ledger (config/sample_matrix.yaml br_inputs).
25:mayDecay = on
25:onMode = off
25:onIfMatch = 5 -5
