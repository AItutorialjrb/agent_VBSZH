# single_r1 WH card B_EW_wmaajj — generated by wh/scripts/make_cards.py; UNVALIDATED until 03 report.
# EW W-gg jj (0,5), on-shell W decay chain, VBS-biased (mjj>400)
# OUTDIR/SEED substituted by the runner (wh/scripts/mg5_smoke.sh or lib make_gridpack.sh)
set automatic_html_opening False
set auto_update 0
set nb_core 4
set run_mode 2
set lhapdf_py3 lhapdf-config
import model sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~
define j = g u c d s u~ c~ d~ s~
define j5 = g u c d s b u~ c~ d~ s~ b~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
define lt+ = e+ mu+ ta+
define lt- = e- mu- ta-
define vlt = ve vm vt
define vlt~ = ve~ vm~ vt~
define jw = u c d s u~ c~ d~ s~
generate p p > w- a a j j QCD=0 QED=5, w- > l- vl~
output OUTDIR -nojpeg
launch OUTDIR
0
set run_card ebeam1 6800
set run_card ebeam2 6800
set run_card pdlabel lhapdf
set run_card lhaid 303600
set run_card maxjetflavor 5
set run_card asrwgtflavor 5
set run_card use_syst True
set run_card dynamical_scale_choice 3
set run_card cut_decays False
set run_card ptj 20
set run_card etaj 5
set run_card drjj 0.4
set run_card pta 20
set run_card etaa 2.5
set run_card draa 0.4
set run_card draj 0.4
set run_card mmaa 90
set run_card mmaamax 200
set run_card mmjj 400
set run_card gridpack True
set run_card nevents 1000
set run_card iseed SEED
done
