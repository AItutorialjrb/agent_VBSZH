error        = /eos/user/r/rjiang/vbs_zh_codex_starter/production/condor_logs/final/$(sample)_$(seed).err
log          = /eos/user/r/rjiang/vbs_zh_codex_starter/production/condor_logs/production_final.log
request_cpus   = 1
request_memory = 2500
+JobFlavour  = "$(flav)"
max_retries  = 2
success_exit_code = 0
on_exit_hold = (ExitCode =?= 19)
on_exit_hold_reason = "gridpack not yet available"
periodic_release = (HoldReasonCode =?= 3) && ((time() - EnteredCurrentStatus) > 1800) && (NumJobStarts < 200)
