# Tier-1 production v2 (samples whose gridpacks passed M5+M6: v1 gridpacks). NOT SUBMITTED in run 2.
# Submit (EosSubmit schedd):
#   bash -lc 'module load lxbatch/eossubmit; cd /eos/user/r/rjiang/vbs_zh_codex_starter/scripts/condor; condor_submit production_tier1.sub'
# Wrapper v2: slim Delphes (delphes_card_CMS_slim_v1, RandomSeed pinned) + GenTruth friend; LHE kept (keep_lhe=1) for re-simulation.
# Seeds: mg_seed = base + Step -> EW 13611000-13611099, QCD 13621000-13621049 (disjoint from test seeds 13610001/13620001).
# Re-submitting is safe: run_job.sh exits early when <tag>.root already exists on EOS.
P            = /eos/user/r/rjiang/vbs_zh_codex_starter
universe     = vanilla
executable   = run_job.sh
arguments    = $(sample) /eos/user/r/rjiang/vbs_zh_codex_starter/production/gridpacks/$(sample)_v1.tar.gz 2000 $INT(seed) $(cmnd) /eos/user/r/rjiang/vbs_zh_codex_starter/production/v1/$(sample) 1 0
transfer_input_files = $(P)/scripts/setup_stack.sh, $(P)/scripts/run_py8_delphes.sh, $(P)/scripts/slim_gentruth.py, $(P)/cards/phase03_smoke/py8_common_CP5.cmnd, $(P)/cards/phase03_smoke/$(cmnd), $(P)/cards/phase04_candidates/delphes_card_CMS_slim_v1.tcl
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
output       = $(P)/production/condor_logs/v1_$(sample)_$(Step).out
error        = $(P)/production/condor_logs/v1_$(sample)_$(Step).err
log          = $(P)/production/condor_logs/production_tier1.log
request_cpus   = 1
request_memory = 2500
+JobFlavour  = "microcentury"
max_retries  = 2
success_exit_code = 0

sample = ew_zhjj_zll
cmnd   = py8_ew_zhjj_haa.cmnd
seed   = 13611000 + $(Step)
queue 100

sample = qcd_zhjj_zll
cmnd   = py8_qcd_zhjj_haa.cmnd
seed   = 13621000 + $(Step)
queue 50
