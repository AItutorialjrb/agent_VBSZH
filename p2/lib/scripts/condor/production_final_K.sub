P            = /eos/user/r/rjiang/vbs_zh_codex_starter
universe     = vanilla
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
executable   = run_job.sh
arguments    = $(sample) /eos/user/r/rjiang/vbs_zh_codex_starter/production/gridpacks/$(sample)_gridpack_s$(gseed).tar.gz $(nev) $(seed) $(cmnd) /eos/user/r/rjiang/vbs_zh_codex_starter/production/final/$(sample) 0 0
