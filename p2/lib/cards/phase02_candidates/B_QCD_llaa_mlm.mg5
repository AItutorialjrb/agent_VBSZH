# UNVALIDATED Phase 02 candidate (see README.md). Run-card pins as cards/phase03_smoke + YAML gen cuts.
import model sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~
define j = g u c d s b u~ c~ d~ s~ b~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~
generate p p > l+ l- a a @0
add process p p > l+ l- a a j @1
add process p p > l+ l- a a j j @2
